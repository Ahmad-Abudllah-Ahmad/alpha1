# Copy to `.env.local` and fill in values:
#   cp .env.example .env.local
#
# Local machine only — `.env.local` is gitignored. Do not commit secrets.

# Host
# http://127.0.0.1:3005
PORT=3005

# Iframe src (dev loads Vite directly so HMR works)
NEXT_PUBLIC_OPENTAKEOFF_URL=http://127.0.0.1:5180/takeoff/

# Next /takeoff rewrite target (next.config.ts)
OPENTAKEOFF_ORIGIN=http://127.0.0.1:5180

# Supabase Auth only (never put service_role here).
# Alpha login/register uses Auth API only — do not use these for table/REST access in Alpha.
# Copy URL + anon key from your Supabase project (same as OpenTakeoff VITE_SUPABASE_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
